[Unit]
Description=ASLCP privileged helper
Documentation=file:///usr/share/doc/aslcp/README
Requires=aslcp-helper.socket
After=aslcp-helper.socket

[Service]
Type=simple
# Runs as root, socket-activated; exits after 60 s without requests.
ExecStart=/usr/libexec/aslcp/aslcp-helper
# The browser terminal does not run login from this unit: the helper only owns
# the PTY and has systemd start login in its own transient unit
# (aslcp-term-<id>.service, no sandbox), so a user shell does not inherit this
# unit's mount namespace. PrivateTmp and ProtectHome therefore stay on.
# PrivateDevices and NoNewPrivileges are deliberately not set: the PTY must be
# in the host's /dev/pts, where systemd (PID 1) can open it as the unit's tty.
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
