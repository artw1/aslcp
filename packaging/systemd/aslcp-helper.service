[Unit]
Description=ASLCP privileged helper
Documentation=file:///usr/share/doc/aslcp/README
Requires=aslcp-helper.socket
After=aslcp-helper.socket

[Service]
Type=simple
# Runs as root, socket-activated; exits after 60 s without requests.
ExecStart=/usr/libexec/aslcp/aslcp-helper
# No PrivateTmp and no ProtectHome (1.3.3): the browser terminal starts login
# from this unit, and a user shell inherits the unit's mount namespace; with
# them the user would see an empty /home and a private /tmp. NoNewPrivileges
# and PrivateDevices are deliberately not set either (login, su and sudo need
# setuid, and the terminal needs /dev/ptmx).
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
