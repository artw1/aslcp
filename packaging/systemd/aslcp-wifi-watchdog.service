[Unit]
Description=ASLCP setup hotspot watchdog (one pass)
Documentation=file:///usr/share/doc/aslcp/README
After=NetworkManager.service
# Nothing to do on a node without NetworkManager.
ConditionPathExists=/usr/bin/nmcli

[Service]
Type=oneshot
# Runs as root: starts the open setup hotspot when the node has had no
# network for the configured time, and stops it when one connects.
# Started by aslcp-wifi-watchdog.timer; needs no running web server.
ExecStart=/usr/libexec/aslcp/aslcp-helper wifi-watchdog
TimeoutStartSec=120
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
