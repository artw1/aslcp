[Unit]
Description=ASLCP web control panel
Documentation=file:///usr/share/doc/aslcp/README
After=network.target aslcp-helper.socket
Wants=aslcp-helper.socket

[Service]
Type=simple
User=aslcp
Group=aslcp
# Access to the node's control socket comes from the aslcp user's membership
# in group "aslcp-node" (added by the package's postinst); systemd applies the
# user's supplementary groups at start.
ExecStart=/usr/bin/aslcp --config /etc/aslcp/aslcp.conf
Restart=on-failure
RestartSec=3
# Exit status 75 is ASLCP asking for a restart after a restore (the restored
# database is swapped in at start): not a failure, but restart anyway.
SuccessExitStatus=75
RestartForceExitStatus=75
TimeoutStopSec=15
UMask=0027

# Hardening. The service can read /etc/aslcp, /sys/class/thermal and /proc
# (read-only views are kept) and write only to its data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/aslcp
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Not @resources: the Go runtime raises its RLIMIT_NOFILE soft limit at start.
SystemCallFilter=~@privileged
# Fail a filtered call with EPERM instead of killing the service.
SystemCallErrorNumber=EPERM
# No capabilities. For a listen port below 1024 ASLCP needs the drop-in
# aslcp.service.d/port80.conf (AmbientCapabilities and CapabilityBoundingSet
# = CAP_NET_BIND_SERVICE). The System tab, Web port section, writes it when
# you move ASLCP to port 80 (install.sh writes the same file for ASLCP_PORT=80
# and ASLCP_TAKEOVER=1) and "apt purge aslcp" removes it.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
