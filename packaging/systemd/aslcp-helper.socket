[Unit]
Description=ASLCP privileged helper socket

[Socket]
ListenStream=/run/aslcp/helper.sock
# Only root and the aslcp group (the web service) can connect; the helper also
# checks the peer uid with SO_PEERCRED.
SocketMode=0660
SocketUser=root
SocketGroup=aslcp
DirectoryMode=0755
RemoveOnStop=true

[Install]
WantedBy=sockets.target
