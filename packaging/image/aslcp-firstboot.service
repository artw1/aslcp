[Unit]
Description=ASLCP image: per-card secrets (first boot only)
Documentation=file:///usr/share/doc/aslcp/README
ConditionPathExists=/var/lib/aslcp-image/firstboot-needed
Before=asterisk.service aslcp.service
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/aslcp-image/aslcp-firstboot.sh
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
